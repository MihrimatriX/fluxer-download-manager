<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Fluxer.App.Controls"
             xmlns:vm="using:Fluxer.App.ViewModels"
             x:Class="Fluxer.App.App"
             Name="Fluxer"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
      <CornerRadius x:Key="OverlayCornerRadius">10</CornerRadius>
      <x:Double x:Key="RowHeight">44</x:Double>
      <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
      <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI, avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>

      <!-- Line icons (24×24 paths from the design) -->
      <StreamGeometry x:Key="IcAll">M4 6h16M4 12h16M4 18h16</StreamGeometry>
      <StreamGeometry x:Key="IcVideo">M3 6h13v12H3zM16 10l5-3v10l-5-3</StreamGeometry>
      <StreamGeometry x:Key="IcMusic">M9 18V5l11-2v13M9 18a3 3 0 1 1-6 0a3 3 0 1 1 6 0M20 16a3 3 0 1 1-6 0a3 3 0 1 1 6 0</StreamGeometry>
      <StreamGeometry x:Key="IcDoc">M6 3h8l4 4v14H6zM14 3v4h4M9 13h6M9 17h6</StreamGeometry>
      <StreamGeometry x:Key="IcArchive">M4 4h16v4H4zM5 8v12h14V8M10 12h4</StreamGeometry>
      <StreamGeometry x:Key="IcApp">M3 7l9-4 9 4v10l-9 4-9-4zM3 7l9 4 9-4M12 11v10</StreamGeometry>
      <StreamGeometry x:Key="IcTorrent">M6 4v8a6 6 0 0 0 12 0V4M6 8h4M14 8h4</StreamGeometry>
      <StreamGeometry x:Key="IcFolder">M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z</StreamGeometry>
      <StreamGeometry x:Key="IcFile">M6 3h8l4 4v14H6zM14 3v4h4</StreamGeometry>
      <StreamGeometry x:Key="IcPlay">M7 4.5l12 7.5-12 7.5z</StreamGeometry>
      <StreamGeometry x:Key="IcPause">M9 5v14M15 5v14</StreamGeometry>
      <StreamGeometry x:Key="IcTrash">M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3</StreamGeometry>
      <StreamGeometry x:Key="IcUp">M6 15l6-6 6 6</StreamGeometry>
      <StreamGeometry x:Key="IcDown">M6 9l6 6 6-6</StreamGeometry>
      <StreamGeometry x:Key="IcBack">M15 6l-6 6 6 6</StreamGeometry>
      <StreamGeometry x:Key="IcClock">M3 12a9 9 0 1 0 18 0a9 9 0 1 0-18 0M12 7v5l3 2</StreamGeometry>
      <StreamGeometry x:Key="IcPanel">M5 5h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2zM15 5v14</StreamGeometry>
      <StreamGeometry x:Key="IcPlus">M12 5v14M5 12h14</StreamGeometry>
      <StreamGeometry x:Key="IcSearch">M4 11a7 7 0 1 0 14 0a7 7 0 1 0-14 0M20 20l-3.5-3.5</StreamGeometry>
      <StreamGeometry x:Key="IcGauge">M4 16a8 8 0 0 1 16 0M12 16l4-5</StreamGeometry>
      <StreamGeometry x:Key="IcCopy">M10 8h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-8a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2zM16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2</StreamGeometry>
      <StreamGeometry x:Key="IcClose">M6 6l12 12M18 6L6 18</StreamGeometry>
      <StreamGeometry x:Key="IcSortDown">M12 5v14M6 13l6 6 6-6</StreamGeometry>
      <StreamGeometry x:Key="IcLogo">M12 4v11M7 10l5 5 5-5M6 20h12</StreamGeometry>
      <StreamGeometry x:Key="IcGear">M9 12a3 3 0 1 0 6 0a3 3 0 1 0-6 0M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z</StreamGeometry>

      <ResourceDictionary.ThemeDictionaries>
        <!-- ===== Dark: the design (navy, orange accent) ===== -->
        <ResourceDictionary x:Key="Dark">
          <LinearGradientBrush x:Key="NavyGradient" StartPoint="20%,0%" EndPoint="80%,100%">
            <GradientStop Offset="0" Color="#1C2235" />
            <GradientStop Offset="0.55" Color="#232A40" />
            <GradientStop Offset="1" Color="#2B2742" />
          </LinearGradientBrush>
          <SolidColorBrush x:Key="SidebarBrush" Color="Transparent" />
          <SolidColorBrush x:Key="MainBrush" Color="#1E2438" />
          <SolidColorBrush x:Key="SurfaceBrush" Color="#262D45" />
          <SolidColorBrush x:Key="CardBrush" Color="#0BFFFFFF" />
          <SolidColorBrush x:Key="PopupBrush" Color="#262D45" />
          <SolidColorBrush x:Key="ToastBrush" Color="#2A3247" />
          <SolidColorBrush x:Key="TextBrush" Color="#E8EBF2" />
          <SolidColorBrush x:Key="Text2Brush" Color="#C9CEDA" />
          <SolidColorBrush x:Key="SubtleBrush" Color="#A3AABB" />
          <SolidColorBrush x:Key="FaintBrush" Color="#8790A3" />
          <SolidColorBrush x:Key="PanelEdgeBrush" Color="#14FFFFFF" />
          <SolidColorBrush x:Key="WellBrush" Color="#33000000" />
          <SolidColorBrush x:Key="InputBrush" Color="#38000000" />
          <SolidColorBrush x:Key="InputEdgeBrush" Color="#47FFFFFF" />
          <SolidColorBrush x:Key="TrackBrush" Color="#59000000" />
          <SolidColorBrush x:Key="HoverBrush" Color="#0DFFFFFF" />
          <SolidColorBrush x:Key="SelectedBrush" Color="#12FFFFFF" />
          <SolidColorBrush x:Key="SoftButtonBrush" Color="#0FFFFFFF" />
          <SolidColorBrush x:Key="RowLineBrush" Color="#09FFFFFF" />
          <SolidColorBrush x:Key="DividerBrush" Color="#14FFFFFF" />
          <SolidColorBrush x:Key="ChipBrush" Color="#0BFFFFFF" />
          <SolidColorBrush x:Key="OkBrush" Color="#5CC8A0" />
          <SolidColorBrush x:Key="ErrBrush" Color="#FF7A6B" />
          <SolidColorBrush x:Key="ErrTextBrush" Color="#FFB3A9" />
          <SolidColorBrush x:Key="InfoBrush" Color="#6EA8FE" />
          <SolidColorBrush x:Key="InfoTextBrush" Color="#9CC3FF" />
          <SolidColorBrush x:Key="IdleBrush" Color="#6B7385" />
          <SolidColorBrush x:Key="WarnTextBrush" Color="#F7C77A" />
          <SolidColorBrush x:Key="LogoBrush" Color="#3B82F6" />
          <LinearGradientBrush x:Key="GlassBorderBrush" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#33FFFFFF" />
            <GradientStop Offset="1" Color="#0AFFFFFF" />
          </LinearGradientBrush>
          <Color x:Key="ShadowColor">#40000000</Color>

          <!-- Fluent controls in the design language -->
          <SolidColorBrush x:Key="TextControlBackground" Color="#38000000" />
          <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#45000000" />
          <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#47000000" />
          <SolidColorBrush x:Key="TextControlBorderBrush" Color="#14FFFFFF" />
          <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#24FFFFFF" />
          <SolidColorBrush x:Key="TextControlForeground" Color="#E8EBF2" />
          <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#E8EBF2" />
          <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#E8EBF2" />
          <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#8790A3" />
          <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#8790A3" />
          <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#8790A3" />
          <SolidColorBrush x:Key="ComboBoxBackground" Color="#38000000" />
          <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#45000000" />
          <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#47000000" />
          <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#14FFFFFF" />
          <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#24FFFFFF" />
          <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#262D45" />
          <SolidColorBrush x:Key="ButtonBackground" Color="#0FFFFFFF" />
          <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1AFFFFFF" />
          <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#0AFFFFFF" />
          <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#08FFFFFF" />
          <SolidColorBrush x:Key="ButtonBorderBrush" Color="#14FFFFFF" />
          <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#1FFFFFFF" />
          <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#14FFFFFF" />
          <SolidColorBrush x:Key="ButtonForeground" Color="#E8EBF2" />
          <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#E8EBF2" />
          <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#262D45" />
          <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#1AFFFFFF" />
          <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#262D45" />
          <SolidColorBrush x:Key="ToolTipBackground" Color="#2A3247" />
          <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#1AFFFFFF" />
          <SolidColorBrush x:Key="ToolTipForeground" Color="#E8EBF2" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUnchecked" Color="#1F000000" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="#59FFFFFF" />
          <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#38000000" />
          <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#38FFFFFF" />
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#5B6478" />
          <SolidColorBrush x:Key="SliderTrackFill" Color="#59000000" />
          <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent" />
          <SolidColorBrush x:Key="ExpanderContentBackground" Color="Transparent" />
          <SolidColorBrush x:Key="DataGridRowSelectedBackgroundBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="DataGridRowSelectedHoveredBackgroundBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="DataGridRowSelectedUnfocusedBackgroundBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundBrush" Color="#FFFFFF" />
          <Color x:Key="DataGridRowHoveredBackgroundColor">#08FFFFFF</Color>
          <SolidColorBrush x:Key="DataGridGridLinesBrush" Color="#09FFFFFF" />
        </ResourceDictionary>

        <!-- ===== Light: the same structure on a pale blue-grey ===== -->
        <ResourceDictionary x:Key="Light">
          <LinearGradientBrush x:Key="NavyGradient" StartPoint="20%,0%" EndPoint="80%,100%">
            <GradientStop Offset="0" Color="#F3F4F8" />
            <GradientStop Offset="0.55" Color="#EDEFF5" />
            <GradientStop Offset="1" Color="#F0EDF6" />
          </LinearGradientBrush>
          <SolidColorBrush x:Key="SidebarBrush" Color="Transparent" />
          <SolidColorBrush x:Key="MainBrush" Color="#F1F2F7" />
          <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="CardBrush" Color="#B8FFFFFF" />
          <SolidColorBrush x:Key="PopupBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ToastBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="TextBrush" Color="#1C2235" />
          <SolidColorBrush x:Key="Text2Brush" Color="#3A4256" />
          <SolidColorBrush x:Key="SubtleBrush" Color="#5B6375" />
          <SolidColorBrush x:Key="FaintBrush" Color="#7A8296" />
          <SolidColorBrush x:Key="PanelEdgeBrush" Color="#14000000" />
          <SolidColorBrush x:Key="WellBrush" Color="#0D000000" />
          <SolidColorBrush x:Key="InputBrush" Color="#0A000000" />
          <SolidColorBrush x:Key="InputEdgeBrush" Color="#33000000" />
          <SolidColorBrush x:Key="TrackBrush" Color="#1A000000" />
          <SolidColorBrush x:Key="HoverBrush" Color="#0A000000" />
          <SolidColorBrush x:Key="SelectedBrush" Color="#0F000000" />
          <SolidColorBrush x:Key="SoftButtonBrush" Color="#B3FFFFFF" />
          <SolidColorBrush x:Key="RowLineBrush" Color="#0A000000" />
          <SolidColorBrush x:Key="DividerBrush" Color="#14000000" />
          <SolidColorBrush x:Key="ChipBrush" Color="#B3FFFFFF" />
          <SolidColorBrush x:Key="OkBrush" Color="#1E9E6A" />
          <SolidColorBrush x:Key="ErrBrush" Color="#D9473A" />
          <SolidColorBrush x:Key="ErrTextBrush" Color="#B3261E" />
          <SolidColorBrush x:Key="InfoBrush" Color="#2F6FD6" />
          <SolidColorBrush x:Key="InfoTextBrush" Color="#2F6FD6" />
          <SolidColorBrush x:Key="IdleBrush" Color="#9AA1B0" />
          <SolidColorBrush x:Key="WarnTextBrush" Color="#9A6200" />
          <SolidColorBrush x:Key="LogoBrush" Color="#3B82F6" />
          <LinearGradientBrush x:Key="GlassBorderBrush" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#E6FFFFFF" />
            <GradientStop Offset="1" Color="#1A000000" />
          </LinearGradientBrush>
          <Color x:Key="ShadowColor">#1A000000</Color>

          <SolidColorBrush x:Key="TextControlBackground" Color="#B3FFFFFF" />
          <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FFFFFF" />
          <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFF" />
          <SolidColorBrush x:Key="TextControlBorderBrush" Color="#1A000000" />
          <SolidColorBrush x:Key="ComboBoxBackground" Color="#B3FFFFFF" />
          <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#1A000000" />
          <SolidColorBrush x:Key="ButtonBackground" Color="#B3FFFFFF" />
          <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ButtonBorderBrush" Color="#14000000" />
          <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent" />
          <SolidColorBrush x:Key="ExpanderContentBackground" Color="Transparent" />
          <SolidColorBrush x:Key="DataGridRowSelectedBackgroundBrush" Color="#000000" />
          <SolidColorBrush x:Key="DataGridRowSelectedHoveredBackgroundBrush" Color="#000000" />
          <SolidColorBrush x:Key="DataGridRowSelectedUnfocusedBackgroundBrush" Color="#000000" />
          <SolidColorBrush x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundBrush" Color="#000000" />
          <Color x:Key="DataGridRowHoveredBackgroundColor">#08000000</Color>
          <SolidColorBrush x:Key="DataGridGridLinesBrush" Color="#0A000000" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!-- list rows: a veil when selected (theme dictionaries pick its colour; the accent bar is in the row) -->
      <x:Double x:Key="DataGridRowSelectedBackgroundOpacity">0.07</x:Double>
      <x:Double x:Key="DataGridRowSelectedHoveredBackgroundOpacity">0.09</x:Double>
      <x:Double x:Key="DataGridRowSelectedUnfocusedBackgroundOpacity">0.06</x:Double>
      <x:Double x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundOpacity">0.08</x:Double>
      <SolidColorBrush x:Key="DataGridFillerColumnGridLinesBrush" Color="Transparent" />
      <SolidColorBrush x:Key="DataGridCellFocusVisualPrimaryBrush" Color="Transparent" />
      <SolidColorBrush x:Key="DataGridCellFocusVisualSecondaryBrush" Color="Transparent" />
      <SolidColorBrush x:Key="DataGridColumnHeaderBackgroundBrush" Color="Transparent" />

      <ControlTheme x:Key="{x:Type c:SettingRow}" TargetType="c:SettingRow">
        <Setter Property="Template">
          <ControlTemplate>
            <Border Padding="0,10" MinHeight="56" BorderBrush="{DynamicResource RowLineBrush}" BorderThickness="0,0,0,1">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0" Spacing="2">
                  <TextBlock Text="{TemplateBinding Title}" TextWrapping="Wrap" />
                  <TextBlock Text="{TemplateBinding Description}" FontSize="12" TextWrapping="Wrap"
                             Foreground="{DynamicResource SubtleBrush}"
                             IsVisible="{TemplateBinding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
                <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" VerticalAlignment="Center" />
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter>
      </ControlTheme>
    </ResourceDictionary>
  </Application.Resources>

  <Application.DataTemplates>
    <!-- One torrent tree row (folder or file): the add-torrent dialog and the detail panel's Files tab (both virtualized). -->
    <DataTemplate DataType="vm:TorrentNode" x:DataType="vm:TorrentNode">
      <Border MinHeight="34" BorderBrush="{DynamicResource RowLineBrush}" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="20,Auto,*,Auto" ColumnSpacing="6" Margin="{Binding Indent}">
          <Button Classes="icon" Width="20" Height="20" Padding="0" FontSize="10" IsVisible="{Binding IsFolder}"
                  Content="{Binding Chevron}" Command="{Binding ToggleExpandCommand}" AutomationProperties.Name="{Binding Name}" />
          <CheckBox Grid.Column="1" IsChecked="{Binding IsSelected}" IsThreeState="False" MinWidth="0" Padding="0" AutomationProperties.Name="{Binding Name}" />
          <!-- folders: the whole name opens and closes them -->
          <Button Grid.Column="2" Classes="tool" Padding="0" MinHeight="0" CornerRadius="4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                  IsVisible="{Binding IsFolder}" Command="{Binding ToggleExpandCommand}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
              <c:Icon Data="{StaticResource IcFolder}" Size="14" Foreground="{DynamicResource SystemControlHighlightAccentBrush}" />
              <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
            </Grid>
          </Button>
          <Grid Grid.Column="2" ColumnDefinitions="Auto,*" ColumnSpacing="8" IsVisible="{Binding !IsFolder}">
            <c:Icon Data="{StaticResource IcFile}" Size="14" Foreground="{DynamicResource SubtleBrush}" />
            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" ToolTip.Tip="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          </Grid>
          <TextBlock Grid.Column="3" Text="{Binding Meta}" FontSize="12" Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Center" />
        </Grid>
      </Border>
    </DataTemplate>
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Background" Value="{DynamicResource MainBrush}" />
    </Style>
    <Style Selector="TextBlock.icon">
      <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.subtle">
      <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.faint">
      <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <!-- "KATEGORİLER" style group labels -->
    <Style Selector="TextBlock.caps">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="0.7" />
      <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
    </Style>
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="Button">
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tool, ToggleButton.tool">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="9" />
    </Style>
    <Style Selector="Button.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="Button.icon">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <!-- Square soft buttons (detail actions, folder pickers) -->
    <Style Selector="Button.soft">
      <Setter Property="Background" Value="{DynamicResource SoftButtonBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PanelEdgeBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.accent">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- Link-like text button -->
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
    </Style>

    <!-- ===== Panels: translucent card with a hairline edge ===== -->
    <Style Selector="Border.glass, Border.panel">
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardEdgeBrush}" />
      <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <!-- Recessed area (graph, tabs, disk meter) -->
    <Style Selector="Border.well">
      <Setter Property="Background" Value="{DynamicResource WellBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardEdgeBrush}" />
      <Setter Property="BoxShadow" Value="{DynamicResource SunkenShadow}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>
    <!-- Input-like box: dark fill, brighter bottom edge -->
    <Style Selector="Border.field">
      <Setter Property="Background" Value="{DynamicResource InputBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PanelEdgeBrush}" />
      <Setter Property="BorderThickness" Value="1,1,1,1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BoxShadow" Value="{DynamicResource SunkenShadow}" />
    </Style>
    <Style Selector="Border.stat, Border.card">
      <Setter Property="BorderBrush" Value="{DynamicResource CardEdgeBrush}" />
      <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.badge">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.badge > TextBlock">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="0.5" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="MinHeight" Value="36" />
    </Style>
    <Style Selector="MenuFlyoutPresenter, ContextMenu">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="{DynamicResource PopupBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PanelEdgeBrush}" />
    </Style>
    <Style Selector="DataGrid /template/ Rectangle#PART_ColumnHeadersAndRowsSeparator">
      <Setter Property="Fill" Value="{DynamicResource DividerBrush}" />
    </Style>
    <!-- Selected filter pill: filled with the accent, in every window -->
    <Style Selector="ListBox.chips > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.chips > ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <!-- A checked tool toggle shows its icon in the accent, no filled square -->
    <Style Selector="ToggleButton.tool:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.tool:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
    </Style>
    <!-- Neumorphic: raised buttons and chips, pressed/selected/inputs sink in (shadows are empty in other styles) -->
    <Style Selector="Button:not(.tool):not(.icon):not(.caption):not(.link) /template/ ContentPresenter#PART_ContentPresenter, ListBox.chips > ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BoxShadow" Value="{DynamicResource RaisedShadow}" />
    </Style>
    <Style Selector="Button:not(.tool):not(.icon):not(.caption):not(.link):pressed /template/ ContentPresenter#PART_ContentPresenter, ListBox.chips > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BoxShadow" Value="{DynamicResource SunkenShadow}" />
    </Style>
    <Style Selector="TextBox /template/ Border#PART_BorderElement, ComboBox /template/ Border#Background">
      <Setter Property="BoxShadow" Value="{DynamicResource SunkenShadow}" />
    </Style>
    <Style Selector="TimePicker /template/ Button#PART_FlyoutButton /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BoxShadow" Value="{DynamicResource SunkenShadow}" />
    </Style>
    <!-- caption buttons we draw (Appearance.CaptionButtons) -->
    <Style Selector="Button.caption">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="48" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Focusable" Value="False" />
    </Style>
    <Style Selector="Button.caption:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#C42B1C" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Window.motion Button.caption:pressed">
      <Setter Property="RenderTransform" Value="none" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="ProgressBar">
      <Setter Property="MinHeight" Value="6" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Background" Value="{DynamicResource TrackBrush}" />
    </Style>
    <Style Selector="c|Bar">
      <Setter Property="Height" Value="6" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource TrackBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
    </Style>
    <Style Selector="c|Bar.error"><Setter Property="Foreground" Value="{DynamicResource ErrBrush}" /></Style>
    <Style Selector="c|Bar.done"><Setter Property="Foreground" Value="{DynamicResource OkBrush}" /></Style>
    <Style Selector="c|Bar.seed"><Setter Property="Foreground" Value="{DynamicResource InfoBrush}" /></Style>
    <Style Selector="c|Bar.idle"><Setter Property="Foreground" Value="{DynamicResource IdleBrush}" /></Style>
    <Style Selector="ProgressBar.error"><Setter Property="Foreground" Value="{DynamicResource ErrBrush}" /></Style>
    <Style Selector="ProgressBar.done"><Setter Property="Foreground" Value="{DynamicResource OkBrush}" /></Style>
    <Style Selector="ProgressBar.seed"><Setter Property="Foreground" Value="{DynamicResource InfoBrush}" /></Style>
    <Style Selector="ProgressBar.idle"><Setter Property="Foreground" Value="{DynamicResource IdleBrush}" /></Style>

    <!-- ===== Motion (windows get the "motion" class unless the user turned animations off) ===== -->
    <Style Selector="Window.motion Button /template/ ContentPresenter#PART_ContentPresenter, Window.motion ToggleButton /template/ ContentPresenter#PART_ContentPresenter, Window.motion ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.14" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.14" />
          <BrushTransition Property="Foreground" Duration="0:0:0.14" />
        </Transitions>
      </Setter>
    </Style>
    <!-- buttons give a little when pressed -->
    <Style Selector="Window.motion Button, Window.motion ToggleButton">
      <Setter Property="RenderTransform" Value="none" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Window.motion Button:pressed, Window.motion ToggleButton:pressed">
      <Setter Property="RenderTransform" Value="scale(0.97)" />
    </Style>
    <Style Selector="Window.motion DataGridRow /template/ Rectangle#BackgroundRectangle">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
          <BrushTransition Property="Fill" Duration="0:0:0.14" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Window.motion ProgressBar">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Value" Duration="0:0:0.4" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Window.motion c|Bar">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Value" Duration="0:0:0.4" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Window.motion Border.stat, Window.motion Border.card">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.2" />
        </Transitions>
      </Setter>
    </Style>
    <!-- pages slide/fade in instead of popping -->
    <Style Selector="Window.motion :is(Control).page">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.24" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector=":is(Control).page">
      <Setter Property="RenderTransform" Value="none" />
    </Style>
    <Style Selector=":is(Control).page.hidden">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <!-- out of the Tab order and the accessibility tree while faded out -->
      <Setter Property="IsEnabled" Value="False" />
      <Setter Property="RenderTransform" Value="translateY(10px)" />
    </Style>
    <Style Selector="Window.motion Border.sidebar">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Width" Duration="0:0:0.2" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
  </Application.Styles>
</Application>
