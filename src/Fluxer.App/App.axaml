<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Fluxer.App.Controls"
             x:Class="Fluxer.App.App"
             Name="Fluxer"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
      <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>
      <x:Double x:Key="RowHeight">42</x:Double>
      <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
      <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI, avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="SidebarBrush" Color="#F3F3F5" />
          <SolidColorBrush x:Key="MainBrush" Color="#FCFCFD" />
          <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="CardBrush" Color="#F6F6F8" />
          <SolidColorBrush x:Key="SubtleBrush" Color="#77000000" />
          <SolidColorBrush x:Key="DividerBrush" Color="#14000000" />
          <SolidColorBrush x:Key="ChipBrush" Color="#0D000000" />
          <!-- glass edge: bright top, fading down -->
          <LinearGradientBrush x:Key="GlassBorderBrush" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#E6FFFFFF" />
            <GradientStop Offset="1" Color="#1A000000" />
          </LinearGradientBrush>
          <Color x:Key="DataGridRowHoveredBackgroundColor">#0C000000</Color>
          <Color x:Key="ShadowColor">#1A000000</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="SidebarBrush" Color="#1C1C1F" />
          <SolidColorBrush x:Key="MainBrush" Color="#161618" />
          <SolidColorBrush x:Key="SurfaceBrush" Color="#1E1E21" />
          <SolidColorBrush x:Key="CardBrush" Color="#222226" />
          <SolidColorBrush x:Key="SubtleBrush" Color="#8CFFFFFF" />
          <SolidColorBrush x:Key="DividerBrush" Color="#1AFFFFFF" />
          <SolidColorBrush x:Key="ChipBrush" Color="#14FFFFFF" />
          <LinearGradientBrush x:Key="GlassBorderBrush" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#33FFFFFF" />
            <GradientStop Offset="1" Color="#08FFFFFF" />
          </LinearGradientBrush>
          <Color x:Key="DataGridRowHoveredBackgroundColor">#12FFFFFF</Color>
          <Color x:Key="ShadowColor">#40000000</Color>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!-- list selection: soft accent tint instead of the solid Fluent block; no dotted focus box on cells -->
      <SolidColorBrush x:Key="DataGridRowSelectedBackgroundBrush" Color="{DynamicResource SystemAccentColor}" />
      <SolidColorBrush x:Key="DataGridRowSelectedHoveredBackgroundBrush" Color="{DynamicResource SystemAccentColor}" />
      <SolidColorBrush x:Key="DataGridRowSelectedUnfocusedBackgroundBrush" Color="{DynamicResource SystemAccentColor}" />
      <SolidColorBrush x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundBrush" Color="{DynamicResource SystemAccentColor}" />
      <x:Double x:Key="DataGridRowSelectedBackgroundOpacity">0.24</x:Double>
      <x:Double x:Key="DataGridRowSelectedHoveredBackgroundOpacity">0.32</x:Double>
      <x:Double x:Key="DataGridRowSelectedUnfocusedBackgroundOpacity">0.18</x:Double>
      <x:Double x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundOpacity">0.26</x:Double>
      <SolidColorBrush x:Key="DataGridGridLinesBrush" Color="Transparent" />
      <SolidColorBrush x:Key="DataGridFillerColumnGridLinesBrush" Color="Transparent" />
      <SolidColorBrush x:Key="DataGridCellFocusVisualPrimaryBrush" Color="Transparent" />
      <SolidColorBrush x:Key="DataGridCellFocusVisualSecondaryBrush" Color="Transparent" />

      <ControlTheme x:Key="{x:Type c:SettingRow}" TargetType="c:SettingRow">
        <Setter Property="Template">
          <ControlTemplate>
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardEdgeBrush}" BorderThickness="1"
                    BoxShadow="{DynamicResource CardShadow}"
                    CornerRadius="10" Padding="16,11" Margin="{DynamicResource CardGap}" MinHeight="58">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0" Spacing="2">
                  <TextBlock Text="{TemplateBinding Title}" FontSize="14" TextWrapping="Wrap" />
                  <TextBlock Text="{TemplateBinding Description}" FontSize="12" TextWrapping="Wrap"
                             Foreground="{DynamicResource SubtleBrush}"
                             IsVisible="{TemplateBinding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
                <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" VerticalAlignment="Center" />
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter>
      </ControlTheme>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
      <Setter Property="Background" Value="{DynamicResource MainBrush}" />
    </Style>
    <Style Selector="TextBlock.icon">
      <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.subtle">
      <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="2,18,0,8" />
    </Style>
    <Style Selector="Button.tool">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.icon">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <!-- ===== Glass: translucent fill, bright hairline edge, soft shadow ===== -->
    <Style Selector="Border.glass">
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardEdgeBrush}" />
      <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
    </Style>
    <Style Selector="Border.stat, Border.card">
      <Setter Property="BorderBrush" Value="{DynamicResource CardEdgeBrush}" />
      <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="DataGrid /template/ Rectangle#PART_ColumnHeadersAndRowsSeparator">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <!-- Neumorphic: raised buttons and chips, pressed/selected/inputs sink in (shadows are empty in other styles) -->
    <Style Selector="Button:not(.tool):not(.icon):not(.caption):not(.rowAction) /template/ ContentPresenter#PART_ContentPresenter, ListBox.chips > ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BoxShadow" Value="{DynamicResource RaisedShadow}" />
    </Style>
    <Style Selector="Button:not(.tool):not(.icon):not(.caption):not(.rowAction):pressed /template/ ContentPresenter#PART_ContentPresenter, ListBox.chips > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.nav > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BoxShadow" Value="{DynamicResource SunkenShadow}" />
    </Style>
    <Style Selector="TextBox /template/ Border#PART_BorderElement, ComboBox /template/ Border#Background, NumericUpDown /template/ Border#PART_BorderElement">
      <Setter Property="BoxShadow" Value="{DynamicResource SunkenShadow}" />
    </Style>
    <!-- rounded, inset row highlight -->
    <Style Selector="DataGridRow /template/ Rectangle#BackgroundRectangle">
      <Setter Property="RadiusX" Value="8" />
      <Setter Property="RadiusY" Value="8" />
      <Setter Property="Margin" Value="4,1" />
    </Style>
    <Style Selector="Border.pill">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- caption buttons we draw (Appearance.CaptionButtons) -->
    <Style Selector="Button.caption">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="40" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Focusable" Value="False" />
    </Style>
    <Style Selector="Button.caption:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ChipBrush}" />
    </Style>
    <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#C42B1C" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Window.motion Button.caption:pressed">
      <Setter Property="RenderTransform" Value="none" />
    </Style>
    <!-- checkboxes stay square-ish so they never look like radio buttons -->
    <Style Selector="CheckBox">
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="ProgressBar">
      <Setter Property="MinHeight" Value="4" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="CornerRadius" Value="3" />
    </Style>

    <!-- ===== Motion (windows get the "motion" class unless the user turned animations off) ===== -->
    <Style Selector="Window.motion Button /template/ ContentPresenter#PART_ContentPresenter, Window.motion ToggleButton /template/ ContentPresenter#PART_ContentPresenter, Window.motion ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.14" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.14" />
          <BrushTransition Property="Foreground" Duration="0:0:0.14" />
        </Transitions>
      </Setter>
    </Style>
    <!-- buttons give a little when pressed -->
    <Style Selector="Window.motion Button, Window.motion ToggleButton">
      <Setter Property="RenderTransform" Value="none" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Window.motion Button:pressed, Window.motion ToggleButton:pressed">
      <Setter Property="RenderTransform" Value="scale(0.96)" />
    </Style>
    <Style Selector="Window.motion CheckBox.rowCheck">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Window.motion DataGridRow /template/ Rectangle#BackgroundRectangle">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
          <BrushTransition Property="Fill" Duration="0:0:0.14" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Window.motion ProgressBar">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Value" Duration="0:0:0.4" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Window.motion c|ProgressRing">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Value" Duration="0:0:0.4" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Window.motion Border.stat, Window.motion Border.card">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.2" />
        </Transitions>
      </Setter>
    </Style>
    <!-- pages slide/fade in instead of popping -->
    <Style Selector="Window.motion :is(Control).page">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.24" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector=":is(Control).page">
      <Setter Property="RenderTransform" Value="none" />
    </Style>
    <Style Selector=":is(Control).page.hidden">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="RenderTransform" Value="translateY(10px)" />
    </Style>
    <Style Selector="Window.motion Border.sidebar">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Width" Duration="0:0:0.2" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
  </Application.Styles>
</Application>
