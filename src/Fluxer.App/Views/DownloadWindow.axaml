<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Fluxer.App.ViewModels"
        xmlns:c="using:Fluxer.App.Controls"
        xmlns:app="using:Fluxer.App"
        x:Class="Fluxer.App.Views.DownloadWindow"
        x:DataType="vm:DownloadWindowViewModel"
        Title="{Binding Title}" Icon="avares://Fluxer/Assets/fluxer.ico"
        SizeToContent="WidthAndHeight" CanResize="False"
        WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <Style Selector="Border.stat">
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="Margin" Value="0,0,8,8" />
    </Style>
    <Style Selector="TextBlock.statLabel">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}" />
    </Style>
    <Style Selector="TextBlock.statValue">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,3,0,0" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Border.chip">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="9,2" />
    </Style>
  </Window.Styles>

  <StackPanel Margin="22,20,22,18" Width="{Binding ContentWidth}">

    <!-- ===== Header: type tile · name · status · percent ===== -->
    <Grid ColumnDefinitions="Auto,*,Auto">
      <Border Width="40" Height="40" CornerRadius="10" Background="{Binding TileBrush}" VerticalAlignment="Center">
        <TextBlock Classes="icon" Text="{Binding Glyph}" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center" Spacing="5">
        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Border Classes="chip" Background="{Binding StatusBrush}">
            <TextBlock Text="{Binding StatusText}" FontSize="11.5" Foreground="White" />
          </Border>
          <TextBlock Text="{Binding Host}" Classes="subtle" VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>
      <TextBlock Grid.Column="2" Text="{Binding PercentText}" IsVisible="{Binding !IsCompleted}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
    </Grid>

    <!-- ===== Running / paused / failed ===== -->
    <StackPanel IsVisible="{Binding !IsCompleted}" Margin="0,16,0,0">
      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
        <TextBlock Text="{Binding DoneText}" FontSize="13" VerticalAlignment="Bottom" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
          <TextBlock Text="{Binding EtaText}" Classes="subtle" FontSize="13" VerticalAlignment="Bottom" />
          <TextBlock Text="{Binding SpeedText}" FontSize="18" FontWeight="SemiBold" />
        </StackPanel>
      </Grid>
      <ProgressBar Value="{Binding Percent}" IsIndeterminate="{Binding Indeterminate}" MinHeight="8" CornerRadius="4" Foreground="{Binding StatusBrush}" />

      <!-- error banner -->
      <Border IsVisible="{Binding IsFailed}" Background="#22E5484D" CornerRadius="8" Padding="12,10" Margin="0,12,0,0">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <TextBlock Classes="icon" Text="&#xE783;" Foreground="#E5484D" FontSize="16" Margin="0,0,10,0" />
          <TextBlock Grid.Column="1" Text="{Binding ErrorText}" TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button Grid.Column="2" Content="{x:Static app:Strings.RefreshLink}" IsVisible="{Binding CanRefreshLink}" Margin="10,0,0,0"
                  Command="{Binding RefreshLinkCommand}" CommandParameter="{Binding $parent[Window]}" />
        </Grid>
      </Border>

      <!-- details (hidden by default) -->
      <StackPanel IsVisible="{Binding !Compact}">
      <!-- stat cards -->
      <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto" Margin="0,14,-8,0">
        <Border Classes="stat" Grid.Row="0" Grid.Column="0"><StackPanel><TextBlock Classes="statLabel" Text="{x:Static app:Strings.StatAvgSpeed}" /><TextBlock Classes="statValue" Text="{Binding AvgSpeedText}" ToolTip.Tip="{Binding AvgSpeedText}" /></StackPanel></Border>
        <Border Classes="stat" Grid.Row="0" Grid.Column="1"><StackPanel><TextBlock Classes="statLabel" Text="{x:Static app:Strings.StatElapsed}" /><TextBlock Classes="statValue" Text="{Binding ElapsedText}" ToolTip.Tip="{Binding ElapsedText}" /></StackPanel></Border>
        <Border Classes="stat" Grid.Row="0" Grid.Column="2"><StackPanel><TextBlock Classes="statLabel" Text="{x:Static app:Strings.StatConnections}" /><TextBlock Classes="statValue" Text="{Binding ConnectionsText}" ToolTip.Tip="{Binding ConnectionsText}" /></StackPanel></Border>
        <Border Classes="stat" Grid.Row="0" Grid.Column="3"><StackPanel><TextBlock Classes="statLabel" Text="{x:Static app:Strings.StatResumable}" /><TextBlock Classes="statValue" Text="{Binding ResumableText}" ToolTip.Tip="{Binding ResumableText}" /></StackPanel></Border>
        <Border Classes="stat" Grid.Row="1" Grid.Column="0"><StackPanel><TextBlock Classes="statLabel" Text="{x:Static app:Strings.StatSize}" /><TextBlock Classes="statValue" Text="{Binding SizeText}" ToolTip.Tip="{Binding SizeText}" /></StackPanel></Border>
        <Border Classes="stat" Grid.Row="1" Grid.Column="1"><StackPanel><TextBlock Classes="statLabel" Text="{x:Static app:Strings.StatServer}" /><TextBlock Classes="statValue" Text="{Binding ServerText}" ToolTip.Tip="{Binding ServerText}" /></StackPanel></Border>
        <Border Classes="stat" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2"><StackPanel><TextBlock Classes="statLabel" Text="{x:Static app:Strings.InfoSavedTo}" /><TextBlock Classes="statValue" FontWeight="Normal" FontSize="12.5" Text="{Binding SavePath}" TextTrimming="PrefixCharacterEllipsis" ToolTip.Tip="{Binding SavePath}" /></StackPanel></Border>
      </Grid>

      <!-- segment map -->
      <StackPanel IsVisible="{Binding IsHttp}" Margin="0,6,0,0" Spacing="6">
        <TextBlock Classes="subtle" Text="{x:Static app:Strings.SegmentMap}" />
        <c:SegmentMap Height="16" Colorful="True" Segments="{Binding Segments}" Total="{Binding TotalBytes}" />
      </StackPanel>

      <!-- details -->
      <TabControl Margin="-4,12,0,0" Padding="0,6,0,0" Height="210" SelectedIndex="{Binding FirstTab, Mode=OneTime}">
        <TabItem Header="{x:Static app:Strings.TabConnectionsList}" FontSize="13.5" IsVisible="{Binding IsHttp}">
          <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="34,*,90,100,110" Margin="6,0,6,4">
              <TextBlock Classes="statLabel" Text="#" />
              <TextBlock Grid.Column="1" Classes="statLabel" Text="{x:Static app:Strings.ConnRange}" />
              <TextBlock Grid.Column="2" Classes="statLabel" Text="{x:Static app:Strings.ConnDownloaded}" />
              <TextBlock Grid.Column="3" Classes="statLabel" Text="{x:Static app:Strings.ColSpeed}" />
              <TextBlock Grid.Column="4" Classes="statLabel" Text="{x:Static app:Strings.ColStatus}" />
            </Grid>
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding Connections}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ConnectionRow">
                    <Grid ColumnDefinitions="34,*,90,100,110" Margin="6,3">
                      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{Binding Dot}" />
                        <TextBlock Text="{Binding Number}" FontSize="12" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Margin="0,0,12,0" Spacing="3">
                        <TextBlock Text="{Binding Range}" FontSize="12" />
                        <ProgressBar Value="{Binding Percent}" MinHeight="3" Height="3" Foreground="{Binding Dot}" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding Done}" FontSize="12" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="3" Text="{Binding Speed}" FontSize="12" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="4" Text="{Binding State}" Classes="subtle" VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </TabItem>
        <TabItem Header="{x:Static app:Strings.TabPeers}" FontSize="13.5" IsVisible="{Binding IsTorrent}">
          <ListBox ItemsSource="{Binding Peers}" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:PeerRow">
                <Grid ColumnDefinitions="*,110,80,80,45">
                  <TextBlock Text="{Binding Address}" TextTrimming="CharacterEllipsis" FontSize="12" />
                  <TextBlock Grid.Column="1" Classes="subtle" Text="{Binding Client}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Client}" />
                  <TextBlock Grid.Column="2" Text="{Binding Down}" FontSize="12" />
                  <TextBlock Grid.Column="3" Text="{Binding Up}" FontSize="12" />
                  <TextBlock Grid.Column="4" Classes="subtle" Text="{Binding Progress}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </TabItem>
        <TabItem Header="{x:Static app:Strings.SpeedGraph}" FontSize="13.5">
          <c:SpeedGraph Values="{Binding SpeedHistory}" Capacity="120" Margin="4" />
        </TabItem>
      </TabControl>

      <!-- when done -->
      <WrapPanel Margin="0,10,0,0">
        <CheckBox Content="{x:Static app:Strings.WhenDoneOpenFile}" IsChecked="{Binding OpenFileWhenDone}" Margin="0,0,16,0" />
        <CheckBox Content="{x:Static app:Strings.WhenDoneOpenFolder}" IsChecked="{Binding OpenFolderWhenDone}" Margin="0,0,16,0" />
        <CheckBox Content="{x:Static app:Strings.WhenDoneClose}" IsChecked="{Binding CloseWhenDone}" />
      </WrapPanel>
      </StackPanel>

      <!-- buttons -->
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,14,0,0">
        <Button Classes="tool" Command="{Binding ToggleCompactCommand}" ToolTip.Tip="{x:Static app:Strings.CompactTip}"
                AutomationProperties.Name="{x:Static app:Strings.CompactTip}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Classes="icon" Text="&#xE73F;" FontSize="12" />
            <TextBlock Text="{x:Static app:Strings.Details}" FontSize="12.5" />
          </StackPanel>
        </Button>
        <!-- destructive first, primary (accent) last -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Button Content="{x:Static app:Strings.Cancel}" Command="{Binding CancelCommand}" CommandParameter="{Binding $parent[Window]}" />
          <Button Content="{x:Static app:Strings.Hide}" Click="OnHide" ToolTip.Tip="{x:Static app:Strings.HideTip}" />
          <Button Classes="accent" Command="{Binding ToggleCommand}" MinWidth="110" AutomationProperties.Name="{Binding ToggleText}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="icon" Text="{Binding ToggleGlyph}" />
              <TextBlock Text="{Binding ToggleText}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </StackPanel>

    <!-- ===== Completed ===== -->
    <StackPanel IsVisible="{Binding IsCompleted}" Margin="0,14,0,0" Spacing="14">
      <TextBlock Text="{Binding SummaryText}" Classes="subtle" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SavePath}" />
      <StackPanel Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Content="{x:Static app:Strings.Close}" Click="OnClose" />
          <Button Content="{x:Static app:Strings.OpenFolder}" Command="{Binding OpenFolderCommand}" />
          <Button Classes="accent" Content="{x:Static app:Strings.OpenFile}" Command="{Binding OpenFileCommand}" MinWidth="100" />
        </StackPanel>
        <TextBlock x:Name="Countdown" Classes="subtle" HorizontalAlignment="Right" />
      </StackPanel>
    </StackPanel>
  </StackPanel>
</Window>
