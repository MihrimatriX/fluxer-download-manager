<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Fluxer.App.ViewModels"
        xmlns:c="using:Fluxer.App.Controls"
        xmlns:app="using:Fluxer.App"
        x:Class="Fluxer.App.Views.DownloadWindow"
        x:DataType="vm:DownloadWindowViewModel"
        Title="{Binding Title}" Icon="avares://Fluxer/Assets/fluxer.ico"
        SizeToContent="WidthAndHeight" CanResize="False" Topmost="{Binding Pinned}"
        WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <Style Selector="TextBlock.k">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}" />
    </Style>
    <Style Selector="TextBlock.v">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="FontSize" Value="12.5" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="FontSize" Value="12" />
    </Style>
  </Window.Styles>

  <Border Classes="surface" Margin="8,0,8,8">
    <StackPanel Margin="14,12,14,12" Width="{Binding ContentWidth}">

      <!-- ===== Header: type icon · name · status ===== -->
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
        <Border Width="32" Height="32" CornerRadius="7" Background="{DynamicResource ChipBrush}" VerticalAlignment="Center">
          <c:Icon Data="{Binding Icon}" Size="17" Foreground="{Binding IconBrush}" HorizontalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse Width="6" Height="6" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding StatusText}" FontSize="11.5" Foreground="{Binding StatusBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Host}" FontSize="11.5" Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="200" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <TextBlock Text="{Binding PercentText}" IsVisible="{Binding !IsCompleted}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
          <ToggleButton Classes="tool" Width="28" Height="28" MinHeight="28" MinWidth="28" Padding="0" IsChecked="{Binding Pinned}" IsVisible="{Binding !IsCard}"
                        ToolTip.Tip="{x:Static app:Strings.PinOnTop}" AutomationProperties.Name="{x:Static app:Strings.PinOnTop}">
            <c:Icon Data="{StaticResource IcPin}" Size="14" />
          </ToggleButton>
        </StackPanel>
      </Grid>

      <!-- ===== Running / paused / failed ===== -->
      <StackPanel IsVisible="{Binding !IsCompleted}" Margin="0,12,0,0" Spacing="6">
        <Panel Height="6">
          <c:SegmentMap IsVisible="{Binding IsHttp}" Colorful="True" Segments="{Binding Segments}" Total="{Binding TotalBytes}" />
          <ProgressBar IsVisible="{Binding !IsHttp}" Value="{Binding Percent}" IsIndeterminate="{Binding Indeterminate}" Height="6" CornerRadius="3" Foreground="{Binding StatusBrush}" />
        </Panel>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
          <TextBlock Text="{Binding DoneText}" FontSize="12" Foreground="{DynamicResource Text2Brush}" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding EtaText}" FontSize="12" Foreground="{DynamicResource SubtleBrush}" />
            <TextBlock Text="{Binding SpeedText}" FontSize="12" FontWeight="SemiBold" />
          </StackPanel>
        </Grid>

        <!-- error banner -->
        <Border IsVisible="{Binding IsFailed}" Background="{DynamicResource ErrSoftBrush}" CornerRadius="6" Padding="10,7" Margin="0,4,0,0">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <c:Icon Data="{StaticResource IcAlert}" Size="15" Foreground="{DynamicResource ErrBrush}" />
            <TextBlock Grid.Column="1" Text="{Binding ErrorText}" FontSize="12" Foreground="{DynamicResource ErrTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="{x:Static app:Strings.RefreshLink}" IsVisible="{Binding CanRefreshLink}"
                    Command="{Binding RefreshLinkCommand}" CommandParameter="{Binding $parent[Window]}" />
          </Grid>
        </Border>

        <!-- details (hidden until asked for) -->
        <StackPanel IsVisible="{Binding !Compact}" Spacing="10" Margin="0,6,0,0">
          <Border Classes="hline" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="20" RowDefinitions="Auto,Auto,Auto" RowSpacing="5">
            <Grid ColumnDefinitions="*,Auto"><TextBlock Classes="k" Text="{x:Static app:Strings.StatAvgSpeed}" /><TextBlock Grid.Column="1" Classes="v" Text="{Binding AvgSpeedText}" /></Grid>
            <Grid Grid.Column="1" ColumnDefinitions="*,Auto"><TextBlock Classes="k" Text="{x:Static app:Strings.StatElapsed}" /><TextBlock Grid.Column="1" Classes="v" Text="{Binding ElapsedText}" /></Grid>
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto"><TextBlock Classes="k" Text="{x:Static app:Strings.StatConnections}" /><TextBlock Grid.Column="1" Classes="v" Text="{Binding ConnectionsText}" /></Grid>
            <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto"><TextBlock Classes="k" Text="{x:Static app:Strings.StatResumable}" /><TextBlock Grid.Column="1" Classes="v" Text="{Binding ResumableText}" /></Grid>
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto"><TextBlock Classes="k" Text="{x:Static app:Strings.StatSize}" /><TextBlock Grid.Column="1" Classes="v" Text="{Binding SizeText}" /></Grid>
            <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="8"><TextBlock Classes="k" Text="{x:Static app:Strings.StatServer}" /><TextBlock Grid.Column="1" Classes="v" Text="{Binding ServerText}" ToolTip.Tip="{Binding ServerText}" /></Grid>
          </Grid>
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <TextBlock Classes="k" Text="{x:Static app:Strings.InfoSavedTo}" />
            <TextBlock Grid.Column="1" FontSize="12" Text="{Binding SavePath}" TextTrimming="PrefixCharacterEllipsis" ToolTip.Tip="{Binding SavePath}" HorizontalAlignment="Right" />
          </Grid>

          <c:SpeedGraph Height="56" Values="{Binding SpeedHistory}" Capacity="120" ShowScale="True" AutomationProperties.Name="{x:Static app:Strings.SpeedGraph}" />

          <!-- connections (HTTP) -->
          <ScrollViewer MaxHeight="128" IsVisible="{Binding IsHttp}">
            <ItemsControl ItemsSource="{Binding Connections}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ConnectionRow">
                  <Grid ColumnDefinitions="22,*,70,74" ColumnSpacing="8" Margin="0,2">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                      <Ellipse Width="6" Height="6" Fill="{Binding Dot}" />
                      <TextBlock Text="{Binding Number}" FontSize="11" Foreground="{DynamicResource SubtleBrush}" />
                    </StackPanel>
                    <ProgressBar Grid.Column="1" Value="{Binding Percent}" Height="3" MinHeight="3" Foreground="{Binding Dot}" VerticalAlignment="Center" ToolTip.Tip="{Binding Range}" />
                    <TextBlock Grid.Column="2" Text="{Binding Done}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding Speed}" FontSize="11" Foreground="{DynamicResource SubtleBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <!-- peers (torrent) -->
          <ScrollViewer MaxHeight="128" IsVisible="{Binding IsTorrent}">
            <ItemsControl ItemsSource="{Binding Peers}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PeerRow">
                  <Grid ColumnDefinitions="*,90,64,40" ColumnSpacing="8" Margin="0,2">
                    <TextBlock Text="{Binding Address}" TextTrimming="CharacterEllipsis" FontSize="11" />
                    <TextBlock Grid.Column="1" Text="{Binding Client}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{DynamicResource SubtleBrush}" ToolTip.Tip="{Binding Client}" />
                    <TextBlock Grid.Column="2" Text="{Binding Down}" FontSize="11" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="{Binding Progress}" FontSize="11" Foreground="{DynamicResource SubtleBrush}" HorizontalAlignment="Right" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <!-- when done -->
          <WrapPanel>
            <CheckBox Content="{x:Static app:Strings.WhenDoneOpenFile}" IsChecked="{Binding OpenFileWhenDone}" Margin="0,0,14,0" />
            <CheckBox Content="{x:Static app:Strings.WhenDoneOpenFolder}" IsChecked="{Binding OpenFolderWhenDone}" Margin="0,0,14,0" />
            <CheckBox Content="{x:Static app:Strings.WhenDoneClose}" IsChecked="{Binding CloseWhenDone}" />
          </WrapPanel>
        </StackPanel>

        <!-- buttons -->
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,6,0,0">
          <Button Classes="tool" Padding="6,0" Command="{Binding ToggleCompactCommand}" ToolTip.Tip="{x:Static app:Strings.CompactTip}"
                  AutomationProperties.Name="{x:Static app:Strings.CompactTip}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Text="{x:Static app:Strings.Details}" FontSize="12" VerticalAlignment="Center" />
              <c:Icon Data="{StaticResource IcDown}" Size="12" StrokeThickness="2" IsVisible="{Binding Compact}" />
              <c:Icon Data="{StaticResource IcUp}" Size="12" StrokeThickness="2" IsVisible="{Binding !Compact}" />
            </StackPanel>
          </Button>
          <!-- destructive first, primary (accent) last -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
            <Button Content="{x:Static app:Strings.Cancel}" Command="{Binding CancelCommand}" CommandParameter="{Binding $parent[Window]}" />
            <Button Content="{x:Static app:Strings.Hide}" Click="OnHide" ToolTip.Tip="{x:Static app:Strings.HideTip}" />
            <Button Classes="accent" Command="{Binding ToggleCommand}" MinWidth="96" AutomationProperties.Name="{Binding ToggleText}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <c:Icon Data="{Binding ToggleIcon}" Size="13" StrokeThickness="2" Foreground="{DynamicResource OnAccentBrush}" />
                <TextBlock Text="{Binding ToggleText}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </StackPanel>

      <!-- ===== Completed ===== -->
      <StackPanel IsVisible="{Binding IsCompleted}" Margin="0,10,0,0" Spacing="10">
        <TextBlock Text="{Binding SummaryText}" Classes="subtle" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SavePath}" />
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock x:Name="Countdown" Classes="faint" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
            <Button Content="{x:Static app:Strings.Close}" Click="OnClose" />
            <Button Content="{x:Static app:Strings.OpenFolder}" Command="{Binding OpenFolderCommand}" />
            <Button Classes="accent" Content="{x:Static app:Strings.OpenFile}" Command="{Binding OpenFileCommand}" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
