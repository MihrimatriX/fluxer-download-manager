<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Fluxer.App.ViewModels"
        xmlns:c="using:Fluxer.App.Controls"
        xmlns:app="using:Fluxer.App"
        x:Class="Fluxer.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Fluxer" Icon="avares://Fluxer/Assets/fluxer.ico"
        Width="1180" Height="740" MinWidth="780" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        DragDrop.AllowDrop="True">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding AddUrlCommand}" />
    <KeyBinding Gesture="Ctrl+O" Command="{Binding AddTorrentCommand}" />
    <KeyBinding Gesture="Ctrl+V" Command="{Binding PasteCommand}" />
    <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding SettingsCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+P" Command="{Binding PauseAllCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+R" Command="{Binding ResumeAllCommand}" />
  </Window.KeyBindings>

  <Window.Styles>
    <Style Selector="ListBox#List > ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="6,1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="ProgressBar.error">
      <Setter Property="Foreground" Value="#E5484D" />
    </Style>
    <Style Selector="ProgressBar.done">
      <Setter Property="Foreground" Value="#30A46C" />
    </Style>
    <Style Selector="ProgressBar.seed">
      <Setter Property="Foreground" Value="#8E4EC6" />
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="#E5484D" />
    </Style>
    <Style Selector="TextBlock.col">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.head">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ListBox#Categories > ListBoxItem">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Margin" Value="8,1" />
      <Setter Property="Padding" Value="10,7" />
    </Style>
  </Window.Styles>

  <Grid ColumnDefinitions="230,*">
    <!-- Sidebar -->
    <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="16,18,16,12" Spacing="14">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Image Source="avares://Fluxer/Assets/fluxer.png" Width="28" Height="28" />
            <TextBlock Text="Fluxer" Classes="h1" VerticalAlignment="Center" />
          </StackPanel>
          <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,9"
                  Command="{Binding AddUrlCommand}" ToolTip.Tip="Ctrl+N" AutomationProperties.Name="{x:Static app:Strings.NewDownload}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="icon" Text="&#xE710;" />
              <TextBlock Text="{x:Static app:Strings.NewDownload}" />
            </StackPanel>
          </Button>
        </StackPanel>
        <Button DockPanel.Dock="Bottom" Classes="tool" Margin="8,8,8,14" HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left" Command="{Binding SettingsCommand}" AutomationProperties.Name="{x:Static app:Strings.Settings}">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Classes="icon" Text="&#xE713;" />
            <TextBlock Text="{x:Static app:Strings.Settings}" />
          </StackPanel>
        </Button>
        <ListBox x:Name="Categories" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                 Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:CategoryItem">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Classes="icon" Text="{Binding Glyph}" FontSize="15" />
                <TextBlock Text="{Binding Title}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto,Auto,Auto" Background="{DynamicResource MainBrush}">
      <!-- Toolbar -->
      <Grid Margin="12,10,14,6" ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="2">
          <Button Classes="tool" Command="{Binding ResumeCommand}" AutomationProperties.Name="{x:Static app:Strings.Resume}" ToolTip.Tip="{x:Static app:Strings.Resume}">
            <StackPanel Orientation="Horizontal" Spacing="7"><TextBlock Classes="icon" Text="&#xE768;" /><TextBlock Text="{x:Static app:Strings.Resume}" /></StackPanel>
          </Button>
          <Button Classes="tool" Command="{Binding PauseCommand}" AutomationProperties.Name="{x:Static app:Strings.Pause}" ToolTip.Tip="{x:Static app:Strings.Pause}">
            <StackPanel Orientation="Horizontal" Spacing="7"><TextBlock Classes="icon" Text="&#xE769;" /><TextBlock Text="{x:Static app:Strings.Pause}" /></StackPanel>
          </Button>
          <Button Classes="tool" Command="{Binding DeleteCommand}" AutomationProperties.Name="{x:Static app:Strings.Delete}" ToolTip.Tip="{x:Static app:Strings.Delete}">
            <StackPanel Orientation="Horizontal" Spacing="7"><TextBlock Classes="icon" Text="&#xE74D;" /><TextBlock Text="{x:Static app:Strings.Delete}" /></StackPanel>
          </Button>
          <Rectangle Width="1" Margin="8,6" Fill="{DynamicResource DividerBrush}" />
          <Button Classes="tool" Command="{Binding ResumeAllCommand}" AutomationProperties.Name="{x:Static app:Strings.ResumeAll}" ToolTip.Tip="Ctrl+Shift+R">
            <StackPanel Orientation="Horizontal" Spacing="7"><TextBlock Classes="icon" Text="&#xE8EE;" /><TextBlock Text="{x:Static app:Strings.ResumeAll}" /></StackPanel>
          </Button>
          <Button Classes="tool" Command="{Binding PauseAllCommand}" AutomationProperties.Name="{x:Static app:Strings.PauseAll}" ToolTip.Tip="Ctrl+Shift+P">
            <StackPanel Orientation="Horizontal" Spacing="7"><TextBlock Classes="icon" Text="&#xE71A;" /><TextBlock Text="{x:Static app:Strings.PauseAll}" /></StackPanel>
          </Button>
          <Rectangle Width="1" Margin="8,6" Fill="{DynamicResource DividerBrush}" />
          <Button Classes="tool" Command="{Binding AddTorrentCommand}" AutomationProperties.Name="{x:Static app:Strings.AddTorrent}" ToolTip.Tip="Ctrl+O">
            <StackPanel Orientation="Horizontal" Spacing="7"><TextBlock Classes="icon" Text="&#xE8E5;" /><TextBlock Text="{x:Static app:Strings.AddTorrent}" /></StackPanel>
          </Button>
        </StackPanel>
        <TextBox Grid.Column="1" Width="230" AutomationProperties.Name="{x:Static app:Strings.Search}" PlaceholderText="{x:Static app:Strings.Search}" Text="{Binding Search}"
                 InnerLeftContent="{x:Null}" CornerRadius="6" />
      </Grid>

      <!-- Column headers -->
      <Grid Grid.Row="1" Margin="18,4,22,4" ColumnDefinitions="34,*,150,150,100,80,190">
        <TextBlock Grid.Column="1" Classes="head" Text="{x:Static app:Strings.ColName}" />
        <TextBlock Grid.Column="2" Classes="head" Text="{x:Static app:Strings.ColSize}" />
        <TextBlock Grid.Column="3" Classes="head" Text="{x:Static app:Strings.ColProgress}" />
        <TextBlock Grid.Column="4" Classes="head" Text="{x:Static app:Strings.ColSpeed}" />
        <TextBlock Grid.Column="5" Classes="head" Text="{x:Static app:Strings.ColEta}" />
        <TextBlock Grid.Column="6" Classes="head" Text="{x:Static app:Strings.ColStatus}" />
      </Grid>

      <!-- List -->
      <Panel Grid.Row="2">
        <ListBox x:Name="List" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                 SelectionMode="Multiple" Background="Transparent">
          <ListBox.ContextMenu>
            <ContextMenu>
              <MenuItem Header="{x:Static app:Strings.OpenFile}" Command="{Binding OpenFileCommand}" InputGesture="Enter" />
              <MenuItem Header="{x:Static app:Strings.OpenFolder}" Command="{Binding OpenFolderCommand}" />
              <Separator />
              <MenuItem Header="{x:Static app:Strings.Resume}" Command="{Binding ResumeCommand}" />
              <MenuItem Header="{x:Static app:Strings.Pause}" Command="{Binding PauseCommand}" />
              <MenuItem Header="{x:Static app:Strings.RefreshLink}" Command="{Binding RefreshLinkCommand}" />
              <MenuItem Header="{x:Static app:Strings.SpeedLimitTitle}" Command="{Binding SpeedLimitCommand}" />
              <MenuItem Header="{x:Static app:Strings.CopyUrl}" Command="{Binding CopyUrlCommand}" />
              <Separator />
              <MenuItem Header="{x:Static app:Strings.Delete}" Command="{Binding DeleteCommand}" InputGesture="Delete" />
            </ContextMenu>
          </ListBox.ContextMenu>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:DownloadItemViewModel">
              <Grid Height="40" Margin="10,0" ColumnDefinitions="34,*,150,150,100,80,190">
                <TextBlock Classes="icon" Text="{Binding Glyph}" FontSize="17" Opacity="0.8" />
                <TextBlock Grid.Column="1" Classes="col" Text="{Binding Name}" FontSize="13" Margin="0,0,12,0"
                           ToolTip.Tip="{Binding Name}" />
                <TextBlock Grid.Column="2" Classes="col subtle" Text="{Binding SizeText}" />
                <ProgressBar Grid.Column="3" Margin="0,0,16,0" VerticalAlignment="Center"
                             Value="{Binding Progress}" IsIndeterminate="{Binding Indeterminate}"
                             Classes.error="{Binding IsError}" Classes.done="{Binding IsDone}" Classes.seed="{Binding IsSeeding}" />
                <TextBlock Grid.Column="4" Classes="col" Text="{Binding SpeedText}" />
                <TextBlock Grid.Column="5" Classes="col subtle" Text="{Binding EtaText}" />
                <TextBlock Grid.Column="6" Classes="col" Classes.error="{Binding IsError}" Text="{Binding StatusText}"
                           ToolTip.Tip="{Binding StatusText}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Opacity="0.75">
          <TextBlock Classes="icon" Text="&#xE896;" FontSize="44" HorizontalAlignment="Center" />
          <TextBlock Text="{x:Static app:Strings.EmptyTitle}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Text="{x:Static app:Strings.EmptyBody}" Classes="subtle" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="420" TextWrapping="Wrap" />
        </StackPanel>
      </Panel>

      <GridSplitter Grid.Row="3" Height="5" Background="{DynamicResource DividerBrush}" ResizeDirection="Rows"
                    IsVisible="{Binding Detail.HasItem}" />

      <!-- Detail panel -->
      <Border Grid.Row="4" Height="270" IsVisible="{Binding Detail.HasItem}" Background="{DynamicResource SurfaceBrush}">
        <TabControl Margin="12,4,12,0" Padding="0,6,0,0">
          <TabItem Header="{x:Static app:Strings.TabGeneral}" FontSize="14">
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding Detail.Info}" Margin="4,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:InfoRow">
                    <Grid ColumnDefinitions="170,*" Margin="0,3">
                      <TextBlock Classes="subtle" Text="{Binding Label}" />
                      <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" FontSize="12.5" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="{x:Static app:Strings.TabActivity}" FontSize="14">
            <StackPanel Spacing="10" Margin="4,4">
              <StackPanel IsVisible="{Binding Detail.IsHttp}" Spacing="6">
                <TextBlock Classes="subtle" Text="{x:Static app:Strings.SegmentMap}" />
                <c:SegmentMap Height="20" Segments="{Binding Detail.Segments}" Total="{Binding Detail.TotalBytes}" />
              </StackPanel>
              <TextBlock IsVisible="{Binding Detail.IsMedia}" Text="{Binding Detail.MediaProgress}" Classes="subtle" />
              <TextBlock Classes="subtle" Text="{x:Static app:Strings.SpeedGraph}" />
              <c:SpeedGraph Height="120" Values="{Binding Detail.SpeedHistory}" />
            </StackPanel>
          </TabItem>
          <TabItem Header="{x:Static app:Strings.TabHeaders}" FontSize="14" IsVisible="{Binding Detail.IsHttp}">
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding Detail.Headers}" Margin="4,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:InfoRow">
                    <Grid ColumnDefinitions="220,*" Margin="0,2">
                      <TextBlock Classes="subtle" Text="{Binding Label}" FontFamily="Cascadia Mono, Consolas" />
                      <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" FontSize="12" FontFamily="Cascadia Mono, Consolas" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="{x:Static app:Strings.TabPeers}" FontSize="14" IsVisible="{Binding Detail.IsTorrent}">
            <Grid ColumnDefinitions="2*,*">
              <ListBox ItemsSource="{Binding Detail.Peers}" Background="Transparent">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:PeerRow">
                    <Grid ColumnDefinitions="*,120,90,90,50">
                      <TextBlock Classes="col" Text="{Binding Address}" />
                      <TextBlock Grid.Column="1" Classes="col subtle" Text="{Binding Client}" />
                      <TextBlock Grid.Column="2" Classes="col" Text="{Binding Down}" />
                      <TextBlock Grid.Column="3" Classes="col" Text="{Binding Up}" />
                      <TextBlock Grid.Column="4" Classes="col subtle" Text="{Binding Progress}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <ListBox Grid.Column="1" ItemsSource="{Binding Detail.Trackers}" Background="Transparent">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:TrackerRow">
                    <StackPanel>
                      <TextBlock Classes="col" Text="{Binding Url}" />
                      <TextBlock Classes="subtle" Text="{Binding Status}" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </TabItem>
        </TabControl>
      </Border>

      <!-- Status bar -->
      <Border Grid.Row="5" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="16,6">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="subtle" Text="{Binding Summary}" />
          <TextBlock Grid.Column="1" Text="{Binding TotalSpeed}" FontWeight="SemiBold" FontSize="12" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
