<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Fluxer.App.ViewModels"
        xmlns:c="using:Fluxer.App.Controls"
        xmlns:v="using:Fluxer.App.Views"
        xmlns:app="using:Fluxer.App"
        x:Class="Fluxer.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Fluxer" Icon="avares://Fluxer/Assets/fluxer.ico"
        Width="1240" Height="780" MinWidth="820" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        DragDrop.AllowDrop="True">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding AddUrlCommand}" />
    <KeyBinding Gesture="Ctrl+O" Command="{Binding AddTorrentCommand}" />
    <KeyBinding Gesture="Ctrl+V" Command="{Binding PasteCommand}" />
    <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding OpenSettingsCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+P" Command="{Binding PauseAllCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+R" Command="{Binding ResumeAllCommand}" />
    <KeyBinding Gesture="Ctrl+Up" Command="{Binding MoveUpCommand}" />
    <KeyBinding Gesture="Ctrl+Down" Command="{Binding MoveDownCommand}" />
    <KeyBinding Gesture="Ctrl+Home" Command="{Binding MoveTopCommand}" />
    <KeyBinding Gesture="Ctrl+End" Command="{Binding MoveBottomCommand}" />
  </Window.KeyBindings>

  <Window.Resources>
    <SolidColorBrush x:Key="DataGridColumnHeaderBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="DataGridColumnHeaderHoveredBackgroundBrush" Color="#14808080" />
    <SolidColorBrush x:Key="DataGridColumnHeaderPressedBackgroundBrush" Color="#22808080" />
  </Window.Resources>

  <Window.Styles>
    <Style Selector="ListBox.nav > ListBoxItem">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Margin" Value="8,1" />
      <Setter Property="Padding" Value="10,7" />
    </Style>
    <Style Selector="ListBox.chips > ListBoxItem">
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="Padding" Value="12,4" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Background" Value="{DynamicResource ChipBrush}" />
    </Style>
    <Style Selector="DataGrid#List DataGridRow" x:DataType="vm:DownloadItemViewModel">
      <Setter Property="Height" Value="38" />
      <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleText}" />
    </Style>
    <Style Selector="DataGrid#List DataGridCell">
      <Setter Property="FontSize" Value="12.5" />
    </Style>
    <Style Selector="DataGrid#List DataGridColumnHeader">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}" />
    </Style>
    <Style Selector="DataGridRow Button.rowAction">
      <Setter Property="Opacity" Value="0.35" />
    </Style>
    <Style Selector="DataGridRow:pointerover Button.rowAction, DataGridRow:selected Button.rowAction">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ProgressBar.error"><Setter Property="Foreground" Value="#E5484D" /></Style>
    <Style Selector="ProgressBar.done"><Setter Property="Foreground" Value="#30A46C" /></Style>
    <Style Selector="ProgressBar.seed"><Setter Property="Foreground" Value="#8E4EC6" /></Style>
    <Style Selector="TextBlock.error"><Setter Property="Foreground" Value="#E5484D" /></Style>
  </Window.Styles>

  <Grid ColumnDefinitions="220,*">
    <!-- ============ Sidebar ============ -->
    <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="16,18,16,10" Spacing="14">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Image Source="avares://Fluxer/Assets/fluxer.png" Width="28" Height="28" />
            <TextBlock Text="Fluxer" Classes="h1" VerticalAlignment="Center" />
          </StackPanel>
          <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,9"
                  Command="{Binding AddUrlCommand}" ToolTip.Tip="Ctrl+N" AutomationProperties.Name="{x:Static app:Strings.NewDownload}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="icon" Text="&#xE710;" />
              <TextBlock Text="{x:Static app:Strings.NewDownload}" />
            </StackPanel>
          </Button>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,12">
          <Button Classes="tool" Margin="8,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                  Command="{Binding OpenSettingsCommand}" AutomationProperties.Name="{x:Static app:Strings.Settings}" ToolTip.Tip="Ctrl+,">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Classes="icon" Text="&#xE713;" FontSize="15" />
              <TextBlock Text="{x:Static app:Strings.Settings}" />
            </StackPanel>
          </Button>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="{x:Static app:Strings.Categories}" Classes="subtle" Margin="20,4,0,4" />
          <ListBox Classes="nav" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:CategoryItem">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <TextBlock Classes="icon" Text="{Binding Glyph}" FontSize="15" />
                  <TextBlock Text="{Binding Title}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ============ Settings page ============ -->
    <v:SettingsView Grid.Column="1" DataContext="{Binding Settings}" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsSettingsOpen}" />

    <!-- ============ Downloads page ============ -->
    <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto,Auto,Auto" IsVisible="{Binding !IsSettingsOpen}">
      <!-- Toolbar -->
      <Grid Margin="12,10,14,4" ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="2" ClipToBounds="True">
          <Button Classes="tool" Command="{Binding ResumeCommand}" AutomationProperties.Name="{x:Static app:Strings.Resume}" ToolTip.Tip="{x:Static app:Strings.Resume}">
            <StackPanel Orientation="Horizontal" Spacing="7"><TextBlock Classes="icon" Text="&#xE768;" /><TextBlock Text="{x:Static app:Strings.Resume}" /></StackPanel>
          </Button>
          <Button Classes="tool" Command="{Binding PauseCommand}" AutomationProperties.Name="{x:Static app:Strings.Pause}" ToolTip.Tip="{x:Static app:Strings.Pause}">
            <StackPanel Orientation="Horizontal" Spacing="7"><TextBlock Classes="icon" Text="&#xE769;" /><TextBlock Text="{x:Static app:Strings.Pause}" /></StackPanel>
          </Button>
          <Button Classes="tool" Command="{Binding DeleteCommand}" AutomationProperties.Name="{x:Static app:Strings.Delete}" ToolTip.Tip="Delete">
            <StackPanel Orientation="Horizontal" Spacing="7"><TextBlock Classes="icon" Text="&#xE74D;" /><TextBlock Text="{x:Static app:Strings.Delete}" /></StackPanel>
          </Button>
          <Rectangle Width="1" Margin="8,6" Fill="{DynamicResource DividerBrush}" />
          <Button Classes="tool" Command="{Binding MoveUpCommand}" AutomationProperties.Name="{x:Static app:Strings.MoveUp}" ToolTip.Tip="{x:Static app:Strings.MoveUpTip}">
            <TextBlock Classes="icon" Text="&#xE70E;" />
          </Button>
          <Button Classes="tool" Command="{Binding MoveDownCommand}" AutomationProperties.Name="{x:Static app:Strings.MoveDown}" ToolTip.Tip="{x:Static app:Strings.MoveDownTip}">
            <TextBlock Classes="icon" Text="&#xE70D;" />
          </Button>
          <Rectangle Width="1" Margin="8,6" Fill="{DynamicResource DividerBrush}" />
          <Button Classes="tool" Command="{Binding AddTorrentCommand}" AutomationProperties.Name="{x:Static app:Strings.AddTorrent}" ToolTip.Tip="Ctrl+O">
            <StackPanel Orientation="Horizontal" Spacing="7"><TextBlock Classes="icon" Text="&#xE8E5;" /><TextBlock Text="{x:Static app:Strings.AddTorrent}" /></StackPanel>
          </Button>
        </StackPanel>
        <TextBox Grid.Column="1" Width="200" Margin="8,0,0,0" PlaceholderText="{x:Static app:Strings.Search}" Text="{Binding Search}"
                 AutomationProperties.Name="{x:Static app:Strings.Search}" CornerRadius="6" />
      </Grid>

      <!-- State chips -->
      <Grid Grid.Row="1" Margin="16,2,14,8" ColumnDefinitions="*,Auto">
      <ListBox Classes="chips" ItemsSource="{Binding StateFilters}"
               SelectedItem="{Binding SelectedStateFilter}" Background="Transparent">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:StateFilter">
            <TextBlock Text="{Binding Label}" FontSize="12.5" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
        <Button Classes="tool" Padding="8,4" FontSize="12.5" Command="{Binding ResumeAllCommand}" Content="{x:Static app:Strings.ResumeAll}" ToolTip.Tip="Ctrl+Shift+R" />
        <Button Classes="tool" Padding="8,4" FontSize="12.5" Command="{Binding PauseAllCommand}" Content="{x:Static app:Strings.PauseAll}" ToolTip.Tip="Ctrl+Shift+P" />
        <Button Classes="tool" Padding="8,4" FontSize="12.5" Command="{Binding ClearCompletedCommand}" Content="{x:Static app:Strings.ClearCompleted}" ToolTip.Tip="{x:Static app:Strings.ClearCompletedTip}" />
      </StackPanel>
      </Grid>

      <!-- List -->
      <Panel Grid.Row="2">
        <DataGrid x:Name="List" ItemsSource="{Binding View}" SelectedItem="{Binding SelectedItem}"
                  SelectionMode="Extended" IsReadOnly="True" CanUserResizeColumns="True" CanUserSortColumns="True"
                  CanUserReorderColumns="True" GridLinesVisibility="None" HeadersVisibility="Column"
                  Background="Transparent" Margin="8,0,8,0">
          <DataGrid.ContextMenu>
            <ContextMenu>
              <MenuItem Header="{x:Static app:Strings.OpenFile}" Command="{Binding OpenFileCommand}" InputGesture="Enter" />
              <MenuItem Header="{x:Static app:Strings.OpenFolder}" Command="{Binding OpenFolderCommand}" />
              <Separator />
              <MenuItem Header="{x:Static app:Strings.Resume}" Command="{Binding ResumeCommand}" />
              <MenuItem Header="{x:Static app:Strings.Pause}" Command="{Binding PauseCommand}" InputGesture="Space" />
              <MenuItem Header="{x:Static app:Strings.Queue}">
                <MenuItem Header="{x:Static app:Strings.MoveTop}" Command="{Binding MoveTopCommand}" InputGesture="Ctrl+Home" />
                <MenuItem Header="{x:Static app:Strings.MoveUp}" Command="{Binding MoveUpCommand}" InputGesture="Ctrl+Up" />
                <MenuItem Header="{x:Static app:Strings.MoveDown}" Command="{Binding MoveDownCommand}" InputGesture="Ctrl+Down" />
                <MenuItem Header="{x:Static app:Strings.MoveBottom}" Command="{Binding MoveBottomCommand}" InputGesture="Ctrl+End" />
              </MenuItem>
              <MenuItem Header="{x:Static app:Strings.RefreshLink}" Command="{Binding RefreshLinkCommand}" />
              <MenuItem Header="{x:Static app:Strings.SpeedLimitTitle}" Command="{Binding SpeedLimitCommand}" />
              <MenuItem Header="{x:Static app:Strings.CopyUrl}" Command="{Binding CopyUrlCommand}" />
              <Separator />
              <MenuItem Header="{x:Static app:Strings.Delete}" Command="{Binding DeleteCommand}" InputGesture="Delete" />
            </ContextMenu>
          </DataGrid.ContextMenu>
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="{x:Static app:Strings.ColName}" Width="*" MinWidth="180" SortMemberPath="Name" x:DataType="vm:DownloadItemViewModel">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:DownloadItemViewModel">
                  <StackPanel Orientation="Horizontal" Spacing="10" Margin="10,0,8,0" VerticalAlignment="Center">
                    <TextBlock Classes="icon" Text="{Binding Glyph}" FontSize="16" Opacity="0.8" />
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="{x:Static app:Strings.ColSize}" Binding="{Binding SizeText}" SortMemberPath="SizeBytes" Width="130" x:DataType="vm:DownloadItemViewModel" />
            <DataGridTemplateColumn Header="{x:Static app:Strings.ColProgress}" Width="130" SortMemberPath="Progress" x:DataType="vm:DownloadItemViewModel">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:DownloadItemViewModel">
                  <ProgressBar Margin="4,0,12,0" VerticalAlignment="Center" Value="{Binding Progress}" IsIndeterminate="{Binding Indeterminate}"
                               Classes.error="{Binding IsError}" Classes.done="{Binding IsDone}" Classes.seed="{Binding IsSeeding}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="{x:Static app:Strings.ColSpeed}" Binding="{Binding SpeedText}" SortMemberPath="SpeedValue" Width="95" x:DataType="vm:DownloadItemViewModel" />
            <DataGridTextColumn Header="{x:Static app:Strings.ColEta}" Binding="{Binding EtaText}" SortMemberPath="EtaSeconds" Width="75" x:DataType="vm:DownloadItemViewModel" />
            <DataGridTemplateColumn Header="{x:Static app:Strings.ColStatus}" Width="170" SortMemberPath="StateOrder" x:DataType="vm:DownloadItemViewModel">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:DownloadItemViewModel">
                  <TextBlock Margin="8,0" VerticalAlignment="Center" Text="{Binding StatusText}" Classes.error="{Binding IsError}"
                             TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StatusText}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="{x:Static app:Strings.ColAdded}" Binding="{Binding AddedText}" SortMemberPath="AddedAt" Width="105" x:DataType="vm:DownloadItemViewModel" />
            <DataGridTemplateColumn Width="40" CanUserResize="False" CanUserSort="False" x:DataType="vm:DownloadItemViewModel">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:DownloadItemViewModel">
                  <Button Classes="icon rowAction" Content="{Binding ToggleGlyph}" HorizontalAlignment="Center"
                          Command="{Binding $parent[DataGrid].((vm:MainViewModel)DataContext).ToggleItemCommand}" CommandParameter="{Binding}"
                          AutomationProperties.Name="{x:Static app:Strings.RowAction}" ToolTip.Tip="{x:Static app:Strings.RowAction}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
        <StackPanel IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Opacity="0.75">
          <TextBlock Classes="icon" Text="&#xE896;" FontSize="44" HorizontalAlignment="Center" />
          <TextBlock Text="{x:Static app:Strings.EmptyTitle}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Text="{x:Static app:Strings.EmptyBody}" Classes="subtle" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="420" TextWrapping="Wrap" />
        </StackPanel>
      </Panel>

      <GridSplitter Grid.Row="3" Height="5" Background="{DynamicResource DividerBrush}" ResizeDirection="Rows" IsVisible="{Binding Detail.HasItem}" />

      <!-- Detail panel -->
      <Border Grid.Row="4" Height="290" IsVisible="{Binding Detail.HasItem}" Background="{DynamicResource SurfaceBrush}">
        <TabControl Margin="12,4,12,0" Padding="0,6,0,0">
          <TabItem Header="{x:Static app:Strings.TabGeneral}" FontSize="14">
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding Detail.Info}" Margin="4,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:InfoRow">
                    <Grid ColumnDefinitions="170,*" Margin="0,3">
                      <TextBlock Classes="subtle" Text="{Binding Label}" />
                      <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" FontSize="12.5" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="{x:Static app:Strings.TabActivity}" FontSize="14">
            <StackPanel Spacing="10" Margin="4,4">
              <StackPanel IsVisible="{Binding Detail.IsHttp}" Spacing="6">
                <TextBlock Classes="subtle" Text="{x:Static app:Strings.SegmentMap}" />
                <c:SegmentMap Height="20" Segments="{Binding Detail.Segments}" Total="{Binding Detail.TotalBytes}" />
              </StackPanel>
              <TextBlock IsVisible="{Binding Detail.IsMedia}" Text="{Binding Detail.MediaProgress}" Classes="subtle" />
              <TextBlock Classes="subtle" Text="{x:Static app:Strings.SpeedGraph}" />
              <c:SpeedGraph Height="130" Values="{Binding Detail.SpeedHistory}" />
            </StackPanel>
          </TabItem>
          <TabItem Header="{x:Static app:Strings.TabFiles}" FontSize="14" IsVisible="{Binding Detail.IsTorrent}">
            <Panel>
              <TextBlock IsVisible="{Binding Detail.FilesPending}" Text="{x:Static app:Strings.MagnetNoFiles}" Classes="subtle" Margin="4" />
              <ListBox ItemsSource="{Binding Detail.Files}" Background="Transparent">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:TorrentFileItem">
                    <Grid ColumnDefinitions="Auto,*,90,120,50">
                      <CheckBox IsChecked="{Binding IsSelected}" MinWidth="0" Margin="0,0,6,0" AutomationProperties.Name="{Binding Path}" />
                      <TextBlock Grid.Column="1" Text="{Binding Path}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" />
                      <TextBlock Grid.Column="2" Text="{Binding SizeText}" Classes="subtle" VerticalAlignment="Center" />
                      <ProgressBar Grid.Column="3" Value="{Binding Percent}" VerticalAlignment="Center" Margin="0,0,10,0" />
                      <TextBlock Grid.Column="4" Text="{Binding PercentText}" Classes="subtle" VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Panel>
          </TabItem>
          <TabItem Header="{x:Static app:Strings.TabPeers}" FontSize="14" IsVisible="{Binding Detail.IsTorrent}">
            <Grid ColumnDefinitions="2*,*">
              <ListBox ItemsSource="{Binding Detail.Peers}" Background="Transparent">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:PeerRow">
                    <Grid ColumnDefinitions="*,120,90,90,50">
                      <TextBlock Text="{Binding Address}" TextTrimming="CharacterEllipsis" FontSize="12.5" />
                      <TextBlock Grid.Column="1" Classes="subtle" Text="{Binding Client}" />
                      <TextBlock Grid.Column="2" Text="{Binding Down}" FontSize="12.5" />
                      <TextBlock Grid.Column="3" Text="{Binding Up}" FontSize="12.5" />
                      <TextBlock Grid.Column="4" Classes="subtle" Text="{Binding Progress}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <ListBox Grid.Column="1" ItemsSource="{Binding Detail.Trackers}" Background="Transparent">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:TrackerRow">
                    <StackPanel>
                      <TextBlock Text="{Binding Url}" TextTrimming="CharacterEllipsis" FontSize="12.5" />
                      <TextBlock Classes="subtle" Text="{Binding Status}" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </TabItem>
          <TabItem Header="{x:Static app:Strings.TabTorrentOptions}" FontSize="14" IsVisible="{Binding Detail.IsTorrent}">
            <ScrollViewer>
              <StackPanel Margin="0,4,8,4">
                <c:SettingRow Title="{x:Static app:Strings.TorrentDownLimitItem}" Description="{x:Static app:Strings.ZeroIsGlobal}">
                  <NumericUpDown Value="{Binding Detail.TorrentDownKb}" Minimum="0" Maximum="10000000" Increment="100" FormatString="0" Width="170" />
                </c:SettingRow>
                <c:SettingRow Title="{x:Static app:Strings.TorrentUpLimitItem}" Description="{x:Static app:Strings.ZeroIsGlobal}">
                  <NumericUpDown Value="{Binding Detail.TorrentUpKb}" Minimum="0" Maximum="10000000" Increment="100" FormatString="0" Width="170" />
                </c:SettingRow>
                <c:SettingRow Title="{x:Static app:Strings.Sequential}">
                  <ToggleSwitch IsChecked="{Binding Detail.Sequential}" OnContent="" OffContent="" />
                </c:SettingRow>
                <c:SettingRow Title="{x:Static app:Strings.SeedOverride}" Description="{x:Static app:Strings.SeedOverrideDesc}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <NumericUpDown Value="{Binding Detail.SeedRatio}" IsEnabled="{Binding Detail.SeedOverride}" Minimum="0" Maximum="100" Increment="0.1" FormatString="0.0" Width="110" />
                    <NumericUpDown Value="{Binding Detail.SeedMinutes}" IsEnabled="{Binding Detail.SeedOverride}" Minimum="0" Maximum="100000" Increment="10" FormatString="0" Width="130" />
                    <ToggleSwitch IsChecked="{Binding Detail.SeedOverride}" OnContent="" OffContent="" />
                  </StackPanel>
                </c:SettingRow>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="{x:Static app:Strings.TabHeaders}" FontSize="14" IsVisible="{Binding Detail.IsHttp}">
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding Detail.Headers}" Margin="4,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:InfoRow">
                    <Grid ColumnDefinitions="220,*" Margin="0,2">
                      <TextBlock Classes="subtle" Text="{Binding Label}" FontFamily="Cascadia Mono, Consolas" />
                      <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" FontSize="12" FontFamily="Cascadia Mono, Consolas" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </TabItem>
        </TabControl>
      </Border>

      <!-- Status bar -->
      <Border Grid.Row="5" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="16,3">
        <Grid ColumnDefinitions="*,Auto,Auto">
          <TextBlock Classes="subtle" Text="{Binding Summary}" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="tool" Padding="8,3" Margin="0,0,12,0" ToolTip.Tip="{x:Static app:Strings.QuickLimitTip}"
                  AutomationProperties.Name="{x:Static app:Strings.QuickLimitTip}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Classes="icon" Text="&#xEC4A;" FontSize="12" />
              <TextBlock Text="{Binding QuickLimitText}" FontSize="12" />
            </StackPanel>
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="{x:Static app:Strings.Unlimited}" Command="{Binding SetQuickLimitCommand}" CommandParameter="0" />
                <MenuItem Header="256 KB/s" Command="{Binding SetQuickLimitCommand}" CommandParameter="262144" />
                <MenuItem Header="512 KB/s" Command="{Binding SetQuickLimitCommand}" CommandParameter="524288" />
                <MenuItem Header="1 MB/s" Command="{Binding SetQuickLimitCommand}" CommandParameter="1048576" />
                <MenuItem Header="2 MB/s" Command="{Binding SetQuickLimitCommand}" CommandParameter="2097152" />
                <MenuItem Header="5 MB/s" Command="{Binding SetQuickLimitCommand}" CommandParameter="5242880" />
                <MenuItem Header="10 MB/s" Command="{Binding SetQuickLimitCommand}" CommandParameter="10485760" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <TextBlock Grid.Column="2" Text="{Binding TotalSpeed}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
