<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Fluxer.App.ViewModels"
        xmlns:c="using:Fluxer.App.Controls"
        xmlns:app="using:Fluxer.App"
        x:Class="Fluxer.App.Views.AddDownloadWindow"
        x:DataType="vm:AddDownloadViewModel"
        Classes="ownchrome"
        Title="{x:Static app:Strings.NewDownload}" Icon="avares://Fluxer/Assets/fluxer.ico"
        SizeToContent="Height" Width="560" CanResize="False" MaxHeight="860"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

  <Window.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="TextBlock.meta">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}" />
    </Style>
    <Style Selector="Expander">
      <Setter Property="Padding" Value="0,8,0,0" />
    </Style>
  </Window.Styles>

  <Border Background="{DynamicResource SurfaceBrush}">
    <StackPanel Margin="18,12,18,16" Spacing="14">
      <!-- header: drag area with the title, own close button -->
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Background="Transparent" WindowDecorationProperties.ElementRole="TitleBar">
        <Image Source="avares://Fluxer/Assets/fluxer.png" Width="16" Height="16" IsHitTestVisible="False" />
        <TextBlock Grid.Column="1" Text="{x:Static app:Strings.NewDownload}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" IsHitTestVisible="False" />
        <Button Grid.Column="2" Classes="tool" Width="28" Height="28" MinHeight="28" Padding="0" Click="OnCancel" WindowDecorationProperties.ElementRole="User"
                AutomationProperties.Name="{x:Static app:Strings.CloseWindow}" ToolTip.Tip="Esc">
          <c:Icon Data="{StaticResource IcClose}" Size="13" />
        </Button>
      </Grid>

      <!-- link -->
      <StackPanel>
        <TextBlock Classes="label" Text="{x:Static app:Strings.LinkOrMagnet}" />
        <Border Classes="field" MinHeight="34" Padding="2,0,4,0">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
            <TextBox x:Name="UrlBox" Classes="bare" Text="{Binding UrlsText}" AcceptsReturn="True" TextWrapping="NoWrap"
                     MinHeight="32" MaxHeight="100" PlaceholderText="{x:Static app:Strings.UrlsWatermark}"
                     AutomationProperties.Name="{x:Static app:Strings.Urls}" />
            <Border Grid.Column="1" Classes="badge" Background="{Binding BadgeBackground}" IsVisible="{Binding Badge, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBlock Text="{Binding Badge}" Foreground="{Binding BadgeBrush}" />
            </Border>
            <Button Grid.Column="2" Classes="tool" Width="26" Height="26" MinHeight="26" MinWidth="26" Padding="0" Click="OnPaste" VerticalAlignment="Center"
                    ToolTip.Tip="{x:Static app:Strings.PasteTip}" AutomationProperties.Name="{x:Static app:Strings.PasteTip}">
              <c:Icon Data="{StaticResource IcCopy}" Size="14" />
            </Button>
          </Grid>
        </Border>
        <DockPanel Margin="0,6,0,0" IsVisible="{Binding Detected, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <Button DockPanel.Dock="Right" Classes="accent" Margin="10,0,0,0" Height="26" MinHeight="26" Padding="10,0" FontSize="12" VerticalAlignment="Center"
                  Content="{x:Static app:Strings.StartInBrowser}" Command="{Binding OpenPagesInBrowserCommand}" IsVisible="{Binding HasPages}" />
          <TextBlock Text="{Binding Detected}" Foreground="{Binding DetectedBrush}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>
        <TextBlock Margin="0,4,0,0" Text="{Binding PatternText}" Classes="subtle" FontSize="12" TextWrapping="Wrap"
                   IsVisible="{Binding PatternText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>

      <!-- single link: file name with size · resume · type underneath -->
      <StackPanel IsVisible="{Binding IsSingleHttp}">
        <StackPanel DataContext="{Binding Single}" x:DataType="vm:AddItem">
          <TextBlock Classes="label" Text="{x:Static app:Strings.FileName}" />
          <TextBox Text="{Binding Name}" PlaceholderText="{x:Static app:Strings.FileNameAuto}" AutomationProperties.Name="{x:Static app:Strings.FileName}" />
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,5,0,0">
            <TextBlock Classes="meta" Text="{Binding SizeText}" />
            <TextBlock Classes="meta" Text="·" />
            <TextBlock Classes="meta" Text="{Binding ResumeText}" Foreground="{Binding ResumeBrush}" ToolTip.Tip="{x:Static app:Strings.ResumeTile}" />
            <TextBlock Classes="meta" Text="·" />
            <TextBlock Classes="meta" Text="{Binding TypeText}" TextTrimming="CharacterEllipsis" MaxWidth="280" />
          </StackPanel>
          <Border IsVisible="{Binding Warning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" CornerRadius="6" Padding="10,7" Margin="0,8,0,0"
                  Background="{Binding WarningSoft}" BorderBrush="{Binding WarningBrush}" BorderThickness="1">
            <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" FontSize="12" Foreground="{Binding WarningBrush}" />
          </Border>
        </StackPanel>
      </StackPanel>

      <!-- several links -->
      <StackPanel Spacing="6" IsVisible="{Binding IsMulti}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding Count, StringFormat={x:Static app:Strings.LinksFound}}" FontWeight="SemiBold" FontSize="12.5" />
          <TextBlock Grid.Column="1" Text="{Binding TotalText}" Classes="meta" />
        </Grid>
        <Border Classes="field" Padding="10,2" MaxHeight="240">
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Items}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AddItem">
                  <Border MinHeight="30" BorderBrush="{DynamicResource RowLineBrush}" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="22,*,72,110" ColumnSpacing="8">
                      <CheckBox IsChecked="{Binding IsIncluded}" MinWidth="0" MinHeight="0" Padding="0" AutomationProperties.Name="{Binding Name}" />
                      <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Url}" />
                      <TextBlock Grid.Column="2" Text="{Binding SizeText}" Classes="meta" HorizontalAlignment="Right" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="3" Text="{Binding StateText}" FontSize="11.5" Foreground="{Binding StateBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Warning}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </StackPanel>

      <!-- folder -->
      <StackPanel>
        <TextBlock Classes="label" Text="{x:Static app:Strings.SaveTo}" />
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
          <TextBox x:Name="FolderBox" Text="{Binding Folder}" AutomationProperties.Name="{x:Static app:Strings.SaveTo}" />
          <Button Grid.Column="1" Classes="soft" Width="30" Height="30" Padding="0" Click="OnBrowse"
                  ToolTip.Tip="{x:Static app:Strings.Browse}" AutomationProperties.Name="{x:Static app:Strings.Browse}">
            <c:Icon Data="{StaticResource IcFolder}" Size="14" />
          </Button>
          <Button Grid.Column="2" Classes="soft" Width="30" Height="30" Padding="0" IsVisible="{Binding HasRecent}"
                  ToolTip.Tip="{x:Static app:Strings.RecentFolders}" AutomationProperties.Name="{x:Static app:Strings.RecentFolders}">
            <c:Icon Data="{StaticResource IcClock}" Size="14" />
            <Button.Flyout>
              <MenuFlyout ItemsSource="{Binding RecentFolders}">
                <MenuFlyout.ItemContainerTheme>
                  <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="x:String">
                    <Setter Property="Header" Value="{Binding}" />
                    <Setter Property="Command" Value="{Binding $parent[Window].((vm:AddDownloadViewModel)DataContext).PickRecentCommand}" />
                    <Setter Property="CommandParameter" Value="{Binding}" />
                  </ControlTheme>
                </MenuFlyout.ItemContainerTheme>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,5,0,0">
          <TextBlock Text="{Binding FreeSpaceText}" FontSize="11" Foreground="{DynamicResource SubtleBrush}" />
          <TextBlock Text="{x:Static app:Strings.NotEnoughSpace}" Foreground="{DynamicResource ErrBrush}" FontSize="11" IsVisible="{Binding NotEnoughSpace}" />
        </StackPanel>
      </StackPanel>

      <!-- everything most downloads never touch -->
      <Expander Header="{x:Static app:Strings.AdvancedOptions}" HorizontalAlignment="Stretch">
        <StackPanel Spacing="12">
          <StackPanel Spacing="12" IsVisible="{Binding IsSingleHttp}">
            <StackPanel>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="label" Text="{x:Static app:Strings.ConnectionCount}" />
                <TextBlock Grid.Column="1" Text="{Binding Connections, StringFormat='{}{0:0}'}" FontSize="12" />
              </Grid>
              <Slider Minimum="1" Maximum="32" Value="{Binding Connections}" TickFrequency="1" IsSnapToTickEnabled="True"
                      AutomationProperties.Name="{x:Static app:Strings.ConnectionCount}" />
            </StackPanel>
            <StackPanel>
              <TextBlock Classes="label" Text="{x:Static app:Strings.Checksum}" />
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                <ComboBox ItemsSource="{Binding HashAlgorithms}" SelectedIndex="{Binding HashIndex}" MinWidth="100" />
                <TextBox Grid.Column="1" Text="{Binding Hash}" PlaceholderText="{x:Static app:Strings.ChecksumWatermark}" />
              </Grid>
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Classes="label" Text="{x:Static app:Strings.Mirrors}" Margin="0" />
              <TextBox Text="{Binding MirrorsText}" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="56" MaxHeight="110"
                       PlaceholderText="{x:Static app:Strings.MirrorsWatermark}" AutomationProperties.Name="{x:Static app:Strings.Mirrors}" />
              <TextBlock Text="{Binding MirrorError}" Foreground="{DynamicResource ErrBrush}" FontSize="12" TextWrapping="Wrap"
                         IsVisible="{Binding MirrorError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <TextBlock Text="{x:Static app:Strings.MirrorsDesc}" FontSize="11" Foreground="{DynamicResource SubtleBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <StackPanel>
              <TextBlock Classes="label" Text="{x:Static app:Strings.InfoQueue}" />
              <ComboBox ItemsSource="{Binding Queues}" SelectedIndex="{Binding QueueIndex}" HorizontalAlignment="Stretch"
                        AutomationProperties.Name="{x:Static app:Strings.InfoQueue}" />
            </StackPanel>
            <Button Grid.Column="1" Classes="link" FontSize="11.5" Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Bottom" Margin="0,0,0,8"
                    Content="{Binding CategoryText}" ToolTip.Tip="{x:Static app:Strings.Category}">
              <Button.Flyout>
                <MenuFlyout ItemsSource="{Binding Categories}">
                  <MenuFlyout.ItemContainerTheme>
                    <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:CategoryChip">
                      <Setter Property="Header" Value="{Binding Title}" />
                      <Setter Property="Command" Value="{Binding $parent[Window].((vm:AddDownloadViewModel)DataContext).PickCategoryCommand}" />
                      <Setter Property="CommandParameter" Value="{Binding}" />
                    </ControlTheme>
                  </MenuFlyout.ItemContainerTheme>
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </Grid>
        </StackPanel>
      </Expander>

      <!-- footer -->
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
        <CheckBox IsChecked="{Binding DontAskAgain}" FontSize="12" Foreground="{DynamicResource SubtleBrush}" Content="{x:Static app:Strings.DontAskAgain}"
                  ToolTip.Tip="{x:Static app:Strings.ShowAddDialogDesc}" VerticalAlignment="Center" />
        <Button Grid.Column="1" Height="32" Padding="14,0" Click="OnQueue" IsEnabled="{Binding CanSubmit}" IsVisible="{Binding ShowQueueButton}"
                Content="{x:Static app:Strings.AddToQueue}" />
        <Button Grid.Column="2" Classes="accent" Height="32" Padding="16,0" Click="OnSubmit" IsDefault="True" IsEnabled="{Binding CanSubmit}"
                Content="{Binding SubmitText}" AutomationProperties.Name="{Binding SubmitText}" />
      </Grid>
    </StackPanel>
  </Border>
</Window>
