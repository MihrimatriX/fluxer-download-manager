{
  "name": "fluxer-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "icons": "node scripts/icons.mjs",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/icons.mjs && tsc --noEmit && vite build && vite build --mode content && node scripts/firefox.mjs",
    "build:firefox": "node scripts/firefox.mjs",
    "test": "vitest run",
    "store": "node scripts/store-zip.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "happy-dom": "^21.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
